# ---- Mode ----
SHROUD_MODE=demo                 # demo | live
ZCASH_NETWORK=test               # test (demo) | main (live) — validated together with SHROUD_MODE

# ---- Zcash (zcash-devtool) ----
ZDT_BIN=/home/you/zcash-devtool/target/release/zcash-devtool
ZDT_WALLET_DIR=/home/you/shroud-data/wallet
ZDT_IDENTITY_FILE=/home/you/shroud-data/identity.txt
ZDT_SERVER=                      # empty = devtool default (zecrocks → testnet.zec.rocks:443 on testnet)
VAULT_ACCOUNT_UUID=
RECEIPTS_ACCOUNT_UUID=
DESK_ACCOUNT_UUID=
RECEIPT_OUTPUT_ZATS=0            # set 1000 if zero-value outputs are rejected (V-Z-5)
MAX_SINGLE_PAYMENT_ZATS=50000000 # 0.5 ZEC safety cap
DEMO_AMOUNT_SCALE=1               # 1 = vault pays the full quoted price in TAZ; <1 scales it down
MIN_DEMO_ZATS=10000
DEMO_DESK_MIN_CONF=1
BITREFILL_ORDER_MODE=test         # test = free Bitrefill test product; balance = REAL product from store credit
BITREFILL_BALANCE_MAX_ORDER_CENTS=1000   # cap per real order ($10.00)
BITREFILL_BALANCE_MAX_TOTAL_CENTS=2500   # cap across all real orders ($25.00)
BITREFILL_PRICE_CURRENCY=USD             # your Bitrefill account's PRIMARY balance currency (set it to USD on bitrefill.com)

# ---- Pricing / 1Click ----
PRICE_SOURCE=oneclick            # oneclick | coingecko | fixed
ONECLICK_BASE_URL=https://1click.chaindefuser.com
ONECLICK_JWT=                    # optional (free from partners.near-intents.org); without it 0.2% fee on real swaps
ONECLICK_ZEC_ASSET_ID=nep141:zec.omft.near
ONECLICK_USDC_ASSET_ID=nep141:base-0x833589fcd6edb6e08f4c7c32d4f71b54bda02913.omft.near
SLIPPAGE_BPS=100
QUOTE_DEADLINE_MIN=15
DRY_QUOTE_REFUND_ZEC_ADDRESS=    # any valid mainnet ZEC address (dry quotes only)
DRY_QUOTE_RECIPIENT=0x000000000000000000000000000000000000dEaD
FIXED_USD_PER_ZEC=               # offline fallback only — set to today's ZEC price before the demo
SHROUD_FEE_BPS=0                 # live: e.g. 100 = 1% via 1Click appFees
SHROUD_FEE_RECIPIENT=            # NEAR Intents account id that receives appFees

# ---- Bitrefill ----
BITREFILL_MODE=api               # api | mock
BITREFILL_API_KEY=
BITREFILL_PAYMENT_METHOD=usdc_base
BITREFILL_REFUND_ADDRESS=        # live only: your Base address for Bitrefill refunds
FX_USD_PER={"INR":0.012,"EUR":1.08,"USD":1}   # demo pricing when Bitrefill gives no USD price; update before demo

# ---- LLM ----
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
LLM_FALLBACK_BASE_URL=           # empty = same as LLM_BASE_URL
LLM_FALLBACK_API_KEY=            # empty = same as LLM_API_KEY
LLM_FALLBACK_MODEL=openai/gpt-oss-20b   # used on 429/5xx; on Groq each model has its own rate limit
LLM_MAX_STEPS=10
AGENT_HISTORY_TURNS=10

# ---- Telegram ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=
DELIVER_CODES_TO=telegram        # telegram | dashboard

# ---- App ----
API_HOST=127.0.0.1
API_PORT=8787
DASHBOARD_TOKEN=                 # long random string
DASHBOARD_ORIGIN=http://localhost:5173
DB_PATH=./data/shroud.db
CODE_ENCRYPTION_KEY=             # 32 bytes base64 (openssl rand -base64 32)
WORKER_TICK_MS=5000
APPROVAL_TTL_MIN=10
SWAP_TIMEOUT_MIN=15
MAX_STEP_RETRIES=5
LOG_LEVEL=info
